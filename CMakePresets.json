{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with Ninja",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with Ninja",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC",
      "description": "Windows build using MSVC and Ninja",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ucrt64",
      "displayName": "MSYS2 UCRT64 Release",
      "description": "专用于 MSYS2 UCRT64 环境的 Release 构建，输出到 build/ucrt64，安装到 build/package。",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/ucrt64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/package"
      }
    },
    {
      "name": "android",
      "displayName": "Android arm64-v8a Release",
      "description": "Android APK build for arm64-v8a. Requires Qt 6.5+ via vcpkg (qtbase:arm64-android + qtbase:x64-linux for host tools), NDK r26+, Android SDK Build-Tools. Set VCPKG_ROOT, ANDROID_NDK_HOME and ANDROID_SDK_ROOT before configuring.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/android",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared",
        "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "QT_HOST_PATH": "$env{VCPKG_ROOT}/installed/x64-linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "ucrt64",
      "configurePreset": "ucrt64"
    },
    {
      "name": "android",
      "configurePreset": "android"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "configurePreset": "debug"
    }
  ]
}
